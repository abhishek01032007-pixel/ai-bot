# ==============================================================
# NOVA AI CONFIGURATION (MULTI-PROVIDER SUPPORT)
# ==============================================================
# Users can connect their own keys directly in the web UI under Speed Settings,
# or you can set a global server key below on Render / local .env:
#
# 1. Google Gemini Key (AIzaSy...):
#    Get at: https://aistudio.google.com/app/apikey (Free tier available)
#    Default Models: gemini-1.5-flash (Turbo) / gemini-1.5-pro (Precision)
#
# 2. Groq Cloud Key (gsk_...):
#    Get at: https://console.groq.com/keys (14,400 free requests/day)
#    Default Models: llama-3.1-8b-instant (Turbo) / llama-3.3-70b-versatile (Precision)
#
# 3. OpenAI Key (sk-...):
#    Get at: https://platform.openai.com/api-keys
#    Default Models: gpt-4o-mini (Turbo) / gpt-4o (Precision)
#
# 4. Anthropic Claude Key (sk-ant-...):
#    Get at: https://console.anthropic.com/
#    Default Models: claude-3-5-haiku (Turbo) / claude-3-5-sonnet (Precision)
#
# 5. OpenRouter Key (sk-or-...):
#    Get at: https://openrouter.ai/keys
# ==============================================================

# Global Server Key (Optional - will be used as default if user doesn't provide one):
NOVA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
